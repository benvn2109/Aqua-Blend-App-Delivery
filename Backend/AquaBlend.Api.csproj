<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>0a835cfb-d32b-4a3b-95d0-1269332eb915</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.18">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.18" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
  </ItemGroup>

  <!-- The test project lives inside this project's folder, so the SDK's default
       globs would sweep in its sources and its bin/obj output. Excluding only
       Compile let its JSON output be picked up as Content and copied back into
       the test output each build, nesting AquaBlend.Tests\bin one level deeper
       every time. -->
  <ItemGroup>
    <Compile Remove="AquaBlend.Tests/**/*.cs" />
    <Content Remove="AquaBlend.Tests/**" />
    <None Remove="AquaBlend.Tests/**" />
    <EmbeddedResource Remove="AquaBlend.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Data\SeedData\sample_optimisation_result.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>